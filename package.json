{
  "name": "jellyfin-shorts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "build:plugin": "tsc --noEmit && vite build --config vite.plugin.config.ts",
    "check:privacy": "python3 scripts/check_public_source.py",
    "build:all": "npm run build && npm run build:plugin"
  },
  "dependencies": {
    "hls.js": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "description": "Standalone and embedded Jellyfin Shorts player"
}
